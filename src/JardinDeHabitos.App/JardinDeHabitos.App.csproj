<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>JardinDeHabitos.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Jardín de Hábitos</ApplicationTitle>
		<ApplicationId>org.jardindehabitos.app</ApplicationId>
		<ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
		<!-- El teléfono solo necesita arm64; x64 es para el emulador (Debug). Dos ABI en un APK = ~12 MB de más. -->
		<!-- Para probar una Release en el emulador: -p:Emulador=true -->
		<RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(Configuration)' == 'Release' and '$(Emulador)' != 'true'">android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(Configuration)' == 'Release' and '$(Emulador)' == 'true'">android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- App ligera: R8 recorta el código Java/Kotlin que no se usa y el recorte de .NET es completo
	     (la UI es C# puro, sin XAML ni reflexión propia). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidLinkTool>r8</AndroidLinkTool>
		<TrimMode>full</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4EEDF" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\escena_*.svg" BaseSize="360,640" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\JardinDeHabitos.Core\JardinDeHabitos.Core.csproj" />
	</ItemGroup>

</Project>
